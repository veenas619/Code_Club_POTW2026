class Solution {
public:
    vector<int> successfulPairs(vector<int>& spells, vector<int>& potions, long long success) {
        sort(potions.begin(),potions.end());
        int cnt=0;
        vector<int> pairs(spells.size(),0);
        int low=0;
        int high=potions.size()-1;
        int mid;
        long long n;int ans;
        for(int i=0;i<spells.size();i++){
            low=0;high=potions.size()-1;
            mid=0;
            ans=potions.size();
            while(low<=high){
            
                mid=low+(high-low)/2;
                n=(long)potions[mid]*(long)spells[i];
                if(n>=success){
                    ans=mid;
                    high=mid-1;
                }
                else{
                    low=mid+1;
                }
            }
               
                pairs[i]=potions.size()-ans;
                
            }
        
        return pairs;
    }
};
